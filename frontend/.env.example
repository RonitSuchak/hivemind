# Backend address (e.g. http://localhost:8000). Leave empty and the site shows "Lab not connected":
# every number and chart is "not available". There is NO fallback to made-up data.
VITE_API_URL=
# Design work only: set to 1 to load the MADE-UP placeholder files in public/demo/ instead.
# The site then shows a "Showing saved results" notice. Never set this for a real deployment.
VITE_DEMO=
