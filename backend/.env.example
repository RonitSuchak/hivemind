# Copy this file to .env (same folder) and fill it in. Never commit .env.
# Every key here is free. Nothing in the code ever prints these values.

# Google Gemini (free): aistudio.google.com
GEMINI_API_KEY=
# Optional. Change if this model isn't available on your free plan.
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional. Seconds between AI calls in the lab, to stay inside free-plan limits.
GEMINI_MIN_SECONDS=4
# Optional. AI calls per quota day (resets midnight Pacific) and how many to keep for live chat/ask.
GEMINI_DAILY_BUDGET=500
GEMINI_RESERVE=50

# Google Safe Browsing (free, non-commercial): Google Cloud console > enable "Safe Browsing API" > API key
SAFE_BROWSING_API_KEY=

# Admin password for approving/rejecting submissions. Pick a long random one. Empty = admin routes off.
ADMIN_PASSWORD=

# Online only: the Neon Postgres connection string. Empty = JSON files in data/store/ (laptop).
DATABASE_URL=

# Proxies in front of the API that add to X-Forwarded-For: 0 on a laptop, 1 on Render.
PROXY_HOPS=0

# Websites allowed to call the API (comma-separated): the frontend's addresses.
CORS_ORIGINS=http://localhost:5173

# Demo maker tutor service only: the ownership code Hivemind gave it (e.g. HM-7Q4K).
DEMO_MAKER_CODE=
