# Copy this file to .env (same folder) and fill it in. Never commit .env.
# Get a free key at Google AI Studio (aistudio.google.com).
GEMINI_API_KEY=

# Optional. Change if this model isn't available on your free plan.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional. Seconds to wait between AI calls, to stay inside free-plan limits.
GEMINI_MIN_SECONDS=4
